# Supabase project settings (safe to expose the publishable key in a browser app).
# Copy this file to .env.local and replace the placeholders.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
VITE_VLAD_EMAIL=vlad@example.com
VITE_ANDREEA_EMAIL=

# Older projects may still expose an anon key. Use the publishable key above for new projects.
# VITE_SUPABASE_ANON_KEY=your_legacy_anon_key
